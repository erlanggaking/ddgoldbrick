# DD Gold Brick - Environment Variables
# Copy this file to .env.local and fill in the values

# Application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# RajaOngkir API (for shipping cost calculation)
# Get your API key from https://rajaongkir.com/
RAJAONGKIR_API_KEY=your_rajaongkir_api_key

# Midtrans Payment Gateway
# Get your credentials from https://dashboard.midtrans.com/
MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key
MIDTRANS_IS_PRODUCTION=false

# Database (optional - for production use)
# DATABASE_URL=postgresql://user:password@localhost:5432/ddgoldbrick

# Email (optional - for order notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_password

# WhatsApp (for customer support)
NEXT_PUBLIC_WHATSAPP_NUMBER=+6281234567890